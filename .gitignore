# Dependências (Nunca devem ser "comitadas", pois o package.json resolve isso)
node_modules/

# Pastas de Build (Geradas automaticamente pelo Vite ao rodar 'npm run build')
dist/
dist-ssr/

# Caches e Arquivos Temporários (Como a pasta .vite que discutimos antes)
.vite/
.eslintcache

# Logs de Erro do NPM
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variáveis de Ambiente (Segurança)
.env
.env.local
.env.*.local

# Arquivos de Sistema (Lixo do Windows/Mac)
.DS_Store
Thumbs.db